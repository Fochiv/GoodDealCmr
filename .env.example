# ─── Base de données ──────────────────────────────────────────────────────────
# URL de connexion PostgreSQL (Supabase ou autre)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# ou si vous utilisez Supabase :
# SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# Secret pour le hachage des tokens auth (valeur longue et aléatoire)
SESSION_SECRET=change-moi-en-production

# ─── Paiement AshTech Pay ─────────────────────────────────────────────────────
# Clé Direct API serveur de type ak_... (jamais exposée au navigateur)
ASHTECH_API_KEY=ak_votre_cle_direct_api
# Secret webhook de type whsec_... créé dans le tableau de bord AshTech
ASHTECH_WEBHOOK_SECRET=whsec_votre_secret_webhook

# ─── Serveur ──────────────────────────────────────────────────────────────────
# Port du serveur (Plesk le configure automatiquement via Passenger)
PORT=3000

# Environnement
NODE_ENV=production

# URL HTTPS publique du serveur (pour les webhooks AshTech)
# Laisser vide si REPLIT_DEV_DOMAIN est défini (automatique sur Replit)
# BASE_URL=https://votre-domaine.com
