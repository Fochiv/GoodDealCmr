# Base de données Supabase
SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Secret pour le hachage des tokens auth (choisir une valeur longue et aléatoire)
SESSION_SECRET=change-moi-en-production

# Port du serveur (Plesk le configure automatiquement)
PORT=3000

# Environnement
NODE_ENV=production
